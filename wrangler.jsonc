// Cloudflare Workers (static assets) deployment for katarinarankovic.fyi.
// Deploy locally with `npm run deploy`; CI deploys on every push to main
// (see .github/workflows/deploy.yml).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "katarinarankovic-fyi",
  // Same Cloudflare account that hosts the DECOY project; account ids are not secret.
  "account_id": "7ad3dd38c4ca3189d079fb7efdc775f7",
  "compatibility_date": "2026-08-01",
  // Tiny edge script that redirects www. to the apex, then serves assets.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Hash routes (#/lab) never reach the server, but keep SPA fallback so any
    // future path-based routes still resolve to index.html.
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    // The redirect must see every request, including "/" which would otherwise
    // be answered straight from the asset store.
    "run_worker_first": true,
  },
  // Custom domains are already attached to this service through Cloudflare's
  // Workers Domains API. Keep them out of this file so deploy-only tokens do
  // not also need permission to enumerate legacy Workers Routes.
  "workers_dev": false,
  "observability": { "enabled": true },
  "env": {
    // `wrangler deploy --env preview` (optionally with --temporary) publishes to a
    // *.workers.dev URL without touching the custom domain.
    "preview": {
      "routes": [],
      "workers_dev": true,
    },
  },
}
